#!/bin/bash
# CodeSmith CLI launcher.
# Run `codesmith` from any directory to open a session for that directory.

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -h "$SOURCE_PATH" ]; do
    SOURCE_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
    LINK_TARGET="$(readlink "$SOURCE_PATH")"
    if [[ "$LINK_TARGET" = /* ]]; then
        SOURCE_PATH="$LINK_TARGET"
    else
        SOURCE_PATH="$SOURCE_DIR/$LINK_TARGET"
    fi
done
PROJECT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
WORK_DIR="$(pwd)"
COMPOSE_CMD=()

if command -v docker-compose &> /dev/null; then
    COMPOSE_CMD=(docker-compose)
elif command -v docker &> /dev/null && docker compose version &> /dev/null; then
    COMPOSE_CMD=(docker compose)
fi

if [ ${#COMPOSE_CMD[@]} -gt 0 ] && [ -f "$PROJECT_DIR/docker-compose.yml" ]; then
    cd "$PROJECT_DIR"
    exec "${COMPOSE_CMD[@]}" run --rm \
        --entrypoint python3 \
        -e WORK_DIR="$WORK_DIR" \
        -e PYTHONPATH=/codesmith/src \
        -v "$WORK_DIR:/work" \
        -v "$PROJECT_DIR:/codesmith:ro" \
        codesmith-cli -m codesmith "$@"
fi

if [ -f "$PROJECT_DIR/src/codesmith/__main__.py" ]; then
    export PYTHONPATH="$PROJECT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
    cd "$WORK_DIR"
    exec python3 -m codesmith "$@"
fi

echo "Error: CodeSmith CLI not found at $PROJECT_DIR"
exit 1
